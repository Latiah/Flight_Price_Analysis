# Environment / secrets
.env

# Python
.venv/
airflow_env/
airflow_home/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# Airflow
airflow.cfg
airflow.db
# Contents, not the directory itself: git will not descend into an excluded
# directory, so a `!logs/.gitkeep` negation under `logs/` would never match --
# and the directory has to stay tracked, because docker-compose bind-mounts it
# and Docker would otherwise create it root-owned, leaving the scheduler unable
# to write task logs.
logs/*
!logs/.gitkeep
standalone_admin_password.txt

# Pipeline intermediate artifacts (regenerated on each run)
data/processed/*
!data/processed/.gitkeep

# Logs
*.log

# Editors
.idea/
.vscode/
.DS_Store

data/raw/*