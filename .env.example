# Copy to .env before running `docker compose up -d`.
#
# There are no host/hostname settings here on purpose: inside the compose
# network the databases are reached by service name (`mysql`, `postgres`), and
# docker-compose.yml wires those in directly.

# --- MySQL staging ---
MYSQL_DATABASE=flight_staging
MYSQL_USER=flight_user_msql
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
# Host-side port only, for pointing a SQL client at the container. Defaults off
# 3306 so it can coexist with a MySQL already installed on the host.
MYSQL_PORT=3307

# --- PostgreSQL analytics ---
POSTGRES_DATABASE=flight_analytics
POSTGRES_USER=flight_user_pgsql
POSTGRES_PASSWORD=your_password_here
# Host-side port only; see the note above.
POSTGRES_PORT=5433

# --- Airflow ---
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Both keys below are left EMPTY on purpose. Generate your own into .env and
# never commit them: a working key in a tracked template is one that every clone
# would share, because a value that already works never gets regenerated.
#
# AIRFLOW_FERNET_KEY encrypts Connection and Variable passwords in Airflow's
# metadata database.
#   docker compose run --rm --no-deps airflow-scheduler python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
#
# AIRFLOW_SECRET_KEY signs the webserver's session cookies. A known value lets
# anyone who can reach the UI forge a session as any user, admin included.
#   docker compose run --rm --no-deps airflow-scheduler python -c \
#     "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=
# Linux only: set to `id -u` output so files written into the bind-mounted
# logs/ directory are owned by you. Leave as-is on macOS/Windows.
AIRFLOW_UID=50000

# --- Pipeline paths (paths inside the containers) ---
RAW_CSV_PATH=/opt/airflow/data/raw/Flight_Price_Dataset_of_Bangladesh.csv
PROCESSED_DATA_DIR=/opt/airflow/data/processed
